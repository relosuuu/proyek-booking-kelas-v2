# Frontend environment variables — copy this file to .env and fill in your real values
# NEVER commit .env — only commit this .env.example file

# Supabase project URL (from Project Settings -> API)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (from Project Settings -> API)
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# URL of the backend Express server
# In development: http://localhost:3001  (only needed locally!)
# In production on Vercel monorepo: leave this UNSET — the app uses /api by default
REACT_APP_API_URL=http://localhost:3001
